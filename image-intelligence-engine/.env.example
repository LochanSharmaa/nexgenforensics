# Image Intelligence Engine — copy to .env and adjust.
# Every setting is optional in local mode; the stack boots with none of them.

IIE_ENVIRONMENT=local

# --- security ------------------------------------------------------------
# Auto-generated in local/test, MANDATORY in production. An auto-generated key
# rotates on every restart, invalidating all sessions.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
IIE_SECRET_KEY=

# --- datastores ----------------------------------------------------------
# Must use an async driver. Plain postgresql:// selects a blocking one and is
# rejected at startup.
IIE_DATABASE_URL=postgresql+asyncpg://iie:iie@localhost:5432/iie
IIE_REDIS_URL=redis://localhost:6379/0

IIE_S3_ENDPOINT_URL=http://localhost:9000
IIE_S3_ACCESS_KEY=minioadmin
IIE_S3_SECRET_KEY=minioadmin
IIE_S3_BUCKET=iie-artifacts

# --- policy --------------------------------------------------------------
# Leave on outside testing. This is the field that makes the audit trail able
# to answer "why was this examined".
IIE_REQUIRE_LAWFUL_BASIS=true
IIE_DEFAULT_JURISDICTION=IN
IIE_DEFAULT_RETENTION_DAYS=365
IIE_RETENTION_AUTO_PURGE=true
IIE_RETENTION_EXPORT_BEFORE_PURGE=true

# Licence plates are personal data in the EU and several Indian contexts.
IIE_ENABLE_PLATE_EXTRACTION=false

# Bounding boxes used to BLUR faces in report thumbnails, discarded straight
# after. No descriptors, no persistence, no comparison. Enabling this
# strengthens privacy; it does not enable recognition, which is impossible here.
IIE_ENABLE_FACE_DETECTION_FOR_REDACTION=false

# --- crawler -------------------------------------------------------------
IIE_RESPECT_ROBOTS=true
IIE_CRAWL_TIMEOUT_SECONDS=15
IIE_CRAWL_MAX_BYTES=8388608
IIE_CRAWL_PER_DOMAIN_CONCURRENCY=2
IIE_CRAWL_PER_DOMAIN_DELAY_SECONDS=1.0
IIE_SCREENSHOTS_ENABLED=true
IIE_USER_AGENT=IIE/0.2 (image provenance research; +https://example.invalid/iie-bot)

# --- observability -------------------------------------------------------
IIE_LOG_LEVEL=INFO
IIE_LOG_FORMAT=json
IIE_METRICS_ENABLED=true

# --- compose only --------------------------------------------------------
POSTGRES_PASSWORD=iie
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
API_PORT=8000

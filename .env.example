# NexGen iMATCH - example environment configuration.
# Copy to .env and replace every placeholder before running outside local dev.

# ---------------------------------------------------------------- service ---
NEXGEN_ENV=development
NEXGEN_API_HOST=0.0.0.0
NEXGEN_API_PORT=8443
NEXGEN_LOG_LEVEL=INFO

# Comma-separated browser origins allowed to call the API.
NEXGEN_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --------------------------------------------------------------- database ---
# SQLite for local development. Use PostgreSQL in production.
NEXGEN_DATABASE_URL=sqlite:///./runtime/imatch.db
# NEXGEN_DATABASE_URL=postgresql+psycopg://imatch:password@localhost:5432/imatch

# --------------------------------------------------------------- security ---
# REQUIRED. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Left empty deliberately: a placeholder long enough to satisfy the production
# length check would let a copied example file ship a publicly known signing
# key. Empty fails fast in production, and generates an ephemeral per-process
# secret in development.
NEXGEN_JWT_SECRET=
NEXGEN_JWT_ALGORITHM=HS256
NEXGEN_ACCESS_TOKEN_MINUTES=60
NEXGEN_REFRESH_TOKEN_DAYS=7

# Biometric template encryption key (AES-256-GCM), 32 bytes base64-encoded.
# REQUIRED in production. Generate with:
#   python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
# Losing this key makes every stored template permanently unreadable.
NEXGEN_TEMPLATE_KEY=

# Rate limiting (requests per minute, per API key or user).
NEXGEN_RATE_LIMIT_PER_MINUTE=120
NEXGEN_SEARCH_RATE_LIMIT_PER_MINUTE=30

# ----------------------------------------------------------------- engine ---
# There is no fallback mode. The service loads real recognition weights or it
# refuses to start: a substitute embedding would produce numbers that look like
# similarity scores and mean nothing, which is worse than an outage.
#
# Model packs (downloaded to NEXGEN_MODEL_ROOT on first run):
#   buffalo_l   SCRFD-10GF detection + ArcFace w600k_r50, 512-d   (default)
#   buffalo_s   smaller and faster, lower accuracy
#   antelopev2  SCRFD + glintr100 (ResNet100), more accurate, ~2x the cost
NEXGEN_MODEL_PACK=buffalo_l

# Where model weights live. Defaults to ~/.insightface/models
NEXGEN_MODEL_ROOT=

# cpu | cuda. CUDA is a request, not a guarantee: it is used only when the
# CUDAExecutionProvider is actually registered, otherwise the service logs the
# fact and runs on CPU. The model and the arithmetic are identical either way,
# so results never depend on the device. Note that the stock `onnxruntime`
# wheel is CPU-only -- CUDA additionally requires `onnxruntime-gpu` built for
# your GPU's compute capability.
NEXGEN_ENGINE_DEVICE=cpu

# Decision thresholds (cosine similarity on L2-normalized ArcFace templates).
# Operating points, NOT accuracy guarantees. Measured on 25 AgeDB identities
# with buffalo_l, genuine pairs averaged 0.52 and impostor pairs 0.04; at 0.36
# that gave TAR 0.80 at FAR 0.000. Your imagery will differ -- calibrate with
# backend/scripts/calibrate_threshold.py before relying on these.
NEXGEN_MATCH_THRESHOLD=0.42
NEXGEN_REVIEW_THRESHOLD=0.32
NEXGEN_VERIFY_THRESHOLD=0.42
NEXGEN_MIN_QUALITY=0.35
# Detector score below which a face is not considered found at all.
NEXGEN_MIN_DETECTION_CONFIDENCE=0.50

# ------------------------------------------------------------- governance ---
# Require an operator-supplied lawful basis on every biometric search.
NEXGEN_REQUIRE_LAWFUL_BASIS=true
# Days before probe images are purged. 0 disables automatic purge.
NEXGEN_PROBE_RETENTION_DAYS=90
NEXGEN_AUDIT_LOG_PATH=./runtime/audit.jsonl

# ---------------------------------------------------------------- storage ---
NEXGEN_STORAGE_ROOT=./runtime/storage
NEXGEN_MAX_UPLOAD_MB=15

# ------------------------------------------------------------- bootstrap ----
# Used only by scripts/seed.py to create the first tenant and admin.
NEXGEN_SEED_TENANT=nexgen-demo
NEXGEN_SEED_ADMIN_EMAIL=admin@example.com
NEXGEN_SEED_ADMIN_PASSWORD=

# Normalise line endings in the repository to LF regardless of the checkout
# platform. Without this, committing from Windows rewrites whole files as CRLF
# and every diff becomes unreadable.
* text=auto eol=lf

# Shell scripts and Dockerfiles must be LF even on a Windows checkout, or they
# fail inside Linux containers with a confusing "bad interpreter" error.
*.sh text eol=lf
Dockerfile text eol=lf
*.conf text eol=lf

# Windows-native scripts stay CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets: never diffed, never line-ending converted.
*.png binary
*.jpg binary
*.jpeg binary
*.jfif binary
*.gif binary
*.ico binary
*.mp4 binary
*.zip binary
*.onnx binary
*.pt binary
*.pth binary
*.db binary

# Generated lockfiles are collapsed in pull-request diffs.
package-lock.json linguist-generated=true diff=json

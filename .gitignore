# ---------------------------------------------------------------- secrets ---
# Real configuration never enters the repository. Only the example does.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.jks
*.keystore
id_rsa*
id_ed25519*
secrets.*
*.secret

# ------------------------------------------------- biometric & case data ----
# Templates, probe images, enrolment images, audit logs, and case databases.
# This is the most sensitive category in the project: an ArcFace template can
# be inverted into a recognizable approximation of the face it came from, so it
# is treated as equivalent to the photograph itself. None of it belongs in
# version control.
#
# Note the leading slashes. A bare `storage/` matches a directory of that name
# at ANY depth, which is how an earlier revision of this file silently excluded
# source directories that happened to share a name with a runtime path.
/runtime/
/backend/runtime/
/backend/storage/
/storage/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.dump
*.sql
audit.jsonl
*.audit.jsonl

# ------------------------------------------------------- model artefacts ----
# Model packs are downloaded on first run into ~/.insightface/models and are
# hundreds of megabytes. Never commit weights.
#
# Root-anchored: a bare `models/` would also match the source package
# backend/nexgen_engine/models/, which holds the recognizer implementation.
.insightface/
/models/
*.onnx
*.plan
*.engine
*.pt
*.pth
*.trt

# ----------------------------------------------------------------- python ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
*.egg-info/
.eggs/

# ------------------------------------------------------------------- node ---
node_modules/
dist/
dist-ssr/
build/
out/
.vite/
.npm/
.npm-cache
.uv-cache
.yarn-integrity
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.vercel
.vercel-home
.vercel-local
.vercel-data

# ----------------------------------------------------- datasets & binaries --
# Training/evaluation datasets are large and frequently licence-restricted;
# fetch them per the dataset guide instead of committing them.
# Root-anchored: a bare `src/` also matches frontend/src/, which is the entire
# frontend source tree.
/src/
/src_extracted/
*.zip
*.tar
*.tar.gz
*.rec
*.idx
*.crdownload
*.exe
*.msi

# ------------------------------------------------------------ IDE & system --
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.sw?

# Benchmark embedding caches (regenerable; ~900MB)
runtime/benchmarks/embeddings/

# Fine-tuned checkpoints (regenerable; ~94MB each)
runtime/checkpoints/*.pt

# Durable biometric template store - contains encrypted biometric data
runtime/templates.db
runtime/templates.db-wal
runtime/templates.db-shm

# Node runtime distribution committed into the repo root by mistake.
# Not source; ignored rather than deleted in case it is a working install.
node/

# Clean-room verification venv (regenerable via scripts/setup_gpu.py)
.venv-clean/

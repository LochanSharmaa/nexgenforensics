# NexGen iMATCH frontend configuration.
# Copy to .env.local for local development.

# Base URL of the iMATCH API.
# Leave empty in development to use the Vite dev proxy (see vite.config.js),
# which forwards /api to http://localhost:8443 and avoids CORS entirely.
VITE_IMATCH_API_BASE=

# In production this must be an absolute https:// origin, e.g.
# VITE_IMATCH_API_BASE=https://api.nexgenforensics.ai

# Owner auto-session (development only).
# Set all three and the app signs itself in on load instead of showing the
# sign-in screen -- useful when you are the only operator and reload constantly.
# It is a real session: the API still authenticates every request and the audit
# trail still records the account. Ignored by production builds, which compile
# the code path away entirely, so these values cannot reach a shipped bundle.
# VITE_OWNER_EMAIL=admin@nexgen.local
# VITE_OWNER_PASSWORD=
# VITE_OWNER_TENANT=nexgen-demo

# NexGen iMATCH frontend configuration.
# Copy to .env.local for local development.

# Base URL of the iMATCH API.
# Leave empty in development to use the Vite dev proxy (see vite.config.js),
# which forwards /api to http://localhost:8443 and avoids CORS entirely.
VITE_IMATCH_API_BASE=

# In production this must be an absolute https:// origin, e.g.
# VITE_IMATCH_API_BASE=https://api.nexgenforensics.ai

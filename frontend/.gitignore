# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build output
/dist
/build
/coverage

# Environment. The example is committed; anything with real values is not.
# .env.production is the exception: Vite inlines VITE_* into the shipped bundle,
# so its contents are public by construction and it holds only the API origin.
# It is committed so a clean clone builds a working production bundle without
# depending on hosting-dashboard state -- see the file's own header.
.env*
!.env.example
!.env.production

# Misc
.DS_Store
*.pem
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
